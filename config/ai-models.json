{
  "version": 1,
  "downstream": {
    "baseUrl": "https://test1122.up.railway.app/v1",
    "apiKeyEnv": "DOWNSTREAM_API_KEY",
    "discoverModels": true,
    "chat": {
      "defaultModel": "grok-4.5",
      "models": [
        "grok-4.5",
        "claude-haiku-4-5-20251001"
      ],
      "includePatterns": [
        "^claude-",
        "^grok-"
      ]
    },
    "image": {
      "baseUrl": "https://downstream.jbbtoken.cn/v1",
      "apiKeyEnv": "GPT_IMAGE_API_KEY",
      "discoverModels": false,
      "defaultModel": "gpt-image-2",
      "models": [
        "gpt-image-2"
      ],
      "includePatterns": [
        "(?:image|imagine|flux|dall)"
      ],
      "portraitSize": "1024x1536",
      "endpoint": "/images/generations"
    }
  }
}
