{
  "name": "night-mailbox-ai-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build --config vite.config.ts",
    "build:standalone": "node scripts/build-standalone-html.mjs",
    "build:app": "node scripts/build-standalone-html.mjs",
    "build:app-update": "node scripts/build-standalone-html.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run check:syntax && npm run build && npm run build:standalone",
    "test": "npm run check && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "vue": "2.7.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
